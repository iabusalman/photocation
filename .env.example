# Base URL of the Photocation backend API.
VITE_API_BASE=http://localhost:4000

# Google OAuth Web client id (Google Identity Services).
VITE_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# Sign in with Apple — Services ID and the return URL configured in Apple.
VITE_APPLE_CLIENT_ID=com.photocation.web
VITE_APPLE_REDIRECT_URI=http://localhost:5173/login

# Moyasar publishable key (pk_...). The secret key stays on the backend only.
VITE_MOYASAR_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxx

# PayPal Client ID (public). The PayPal secret stays on the backend only.
VITE_PAYPAL_CLIENT_ID=
