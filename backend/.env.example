# ── Server ─────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173

# ── Auth / JWT ─────────────────────────────────────────
# Secret used to sign Photocation's own session tokens. Use a long random string.
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# ── Google Sign-In ─────────────────────────────────────
# OAuth 2.0 Web client ID from Google Cloud Console.
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# ── Sign in with Apple ─────────────────────────────────
# Services ID (the "client_id" / audience of Apple identity tokens).
APPLE_CLIENT_ID=com.photocation.web
# Optionally also accept the native app bundle id as a valid audience.
APPLE_BUNDLE_ID=com.photocation.app

# ── Moyasar payments ───────────────────────────────────
# Secret (sk_...) and publishable (pk_...) API keys from the Moyasar dashboard.
MOYASAR_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxx
MOYASAR_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxx
MOYASAR_API_BASE=https://api.moyasar.com/v1
# Shared secret configured on the Moyasar webhook to verify authenticity.
MOYASAR_WEBHOOK_SECRET=change-me-webhook-secret

# Where to send the user back after a hosted/redirect payment.
PAYMENT_CALLBACK_URL=http://localhost:5173/payment/callback

# ── Database ───────────────────────────────────────────
# Dev default is SQLite. For production use a PostgreSQL URL and switch the
# provider in prisma/schema.prisma.
DATABASE_URL="file:./dev.db"
