// Photocation database schema.
// Dev uses SQLite for zero-setup. For production, switch `provider` to
// "postgresql" and point DATABASE_URL at your Postgres instance.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// NOTE: SQLite has no native enum type. The following string fields are
// constrained to a fixed set of values in application code:
//   User.provider     : "google" | "apple"
//   Booking.status    : "pending" | "confirmed" | "cancelled"
//   Payment.status    : "initiated" | "paid" | "failed" | "refunded"
// When migrating to PostgreSQL these can be promoted to real Prisma enums.

model User {
  id         String    @id @default(cuid())
  email      String    @unique
  name       String?
  avatarUrl  String?
  provider   String // "google" | "apple"
  providerId String // subject ("sub") from the identity provider
  bookings   Booking[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([provider, providerId])
}

// A bookable photography session / location package.
model Package {
  id           String    @id @default(cuid())
  title        String
  description  String
  city         String
  location     String
  coverImage   String?
  // Price in the smallest currency unit (halalas). 50000 = 500.00 SAR.
  priceHalalas Int
  currency     String    @default("SAR")
  durationMins Int       @default(60)
  active       Boolean   @default(true)
  bookings     Booking[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Booking {
  id            String   @id @default(cuid())
  user          User     @relation(fields: [userId], references: [id])
  userId        String
  package       Package  @relation(fields: [packageId], references: [id])
  packageId     String
  scheduledFor  DateTime
  status        String   @default("pending") // pending | confirmed | cancelled
  amountHalalas Int
  currency      String   @default("SAR")
  notes         String?
  payment       Payment?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Payment {
  id            String   @id @default(cuid())
  booking       Booking  @relation(fields: [bookingId], references: [id])
  bookingId     String   @unique
  // Moyasar payment id (returned by the API / present in webhooks).
  moyasarId     String?  @unique
  status        String   @default("initiated") // initiated | paid | failed | refunded
  amountHalalas Int
  currency      String   @default("SAR")
  source        String? // card / applepay / stcpay ...
  description   String?
  rawResponse   String? // last raw payload from Moyasar (JSON string)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
