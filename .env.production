# Production build-time config for the frontend (Vite).
#
# All VITE_* values are PUBLIC by design — they are compiled into the client
# bundle and shipped to every browser, so keeping them here is safe and means
# any host (Cloudflare, Render, Netlify, …) builds a fully-wired site without
# needing dashboard environment variables.
#
# NOTE: a real environment variable set on the host still OVERRIDES these (Vite
# gives existing process env the highest priority), so Render keeps working too.
# Secrets (Moyasar secret key, PayPal secret, JWT secret, Anthropic key) live
# ONLY on the backend and are never placed here.

VITE_API_BASE=https://photocation-api.onrender.com

# Google Identity Services (public OAuth client id)
VITE_GOOGLE_CLIENT_ID=3889765689-cg5hqj9kpmmi85sdam4hf20q7hdsa92u.apps.googleusercontent.com

# Sign in with Apple (Services ID + return URL on the production domain)
VITE_APPLE_CLIENT_ID=com.photoai.photocation
VITE_APPLE_REDIRECT_URI=https://photoai.click/login

# PayPal (public live client id)
VITE_PAYPAL_CLIENT_ID=AdKr8Lb-aETvxVcEvnY5W4KQ2Plt74aTOZ8gpyiQ61od5UmfJcDBRC6v9evMgdO9IdgoffRhSLAU12lT

# Moyasar publishable key — add once Moyasar is live, e.g.
# VITE_MOYASAR_PUBLISHABLE_KEY=pk_live_xxx
