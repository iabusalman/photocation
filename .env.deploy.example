# Copy to `.env` for docker-compose self-hosting.
POSTGRES_PASSWORD=change-me

# Backend
JWT_SECRET=change-me-to-a-long-random-secret-value
CORS_ORIGINS=http://localhost:8080
PAYMENT_CALLBACK_URL=http://localhost:8080/payment/callback
ANALYZE_MODEL=claude-opus-4-8
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
APPLE_BUNDLE_ID=
MOYASAR_SECRET_KEY=
MOYASAR_PUBLISHABLE_KEY=
MOYASAR_WEBHOOK_SECRET=
ANTHROPIC_API_KEY=

# Frontend (baked into the web image at build time)
VITE_API_BASE=http://localhost:4000
VITE_GOOGLE_CLIENT_ID=
VITE_APPLE_CLIENT_ID=
VITE_APPLE_REDIRECT_URI=http://localhost:8080/login
VITE_MOYASAR_PUBLISHABLE_KEY=
